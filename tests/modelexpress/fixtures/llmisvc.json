{
  "apiVersion": "serving.kserve.io/v1alpha2",
  "kind": "LLMInferenceService",
  "metadata": {
    "name": "modelexpress-p2p",
    "namespace": "llm-conformance-test",
    "annotations": {
      "serving.kserve.io/exp-modelexpress-address": "https://modelexpress.llm-conformance-test.svc.cluster.local:8001",
      "serving.kserve.io/exp-modelexpress-ca-bundle-configmap": "openshift-service-ca.crt",
      "serving.kserve.io/exp-modelexpress-ca-bundle-key": "service-ca.crt",
      "serving.kserve.io/exp-modelexpress-mode": "native",
